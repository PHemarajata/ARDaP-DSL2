                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kasA is a ketoacyl acyl carrier protein synthase that catalyzes the condensation reaction of fatty acid synthesis by the addition to an acyl acceptor of two carbons from malonyl-ACP. It is involved in elongation of fatty acids intermediate in the biosynthetic pathway of mycolic acids.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003478</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic sensitive kasA</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000219"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000451"/>
