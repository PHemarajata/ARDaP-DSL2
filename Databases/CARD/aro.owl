        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cefixime is a cephalosporin resistant to most beta-lactamases. It is active against many enterobacteria, but activity against staphylococci is poor.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:2684593</oboInOwl:hasDbXref>
