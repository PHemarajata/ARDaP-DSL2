        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catalyzes the addition of a thiol group from a nucleophilic molecule to fosfomycin.</obo:IAO_0000115>
