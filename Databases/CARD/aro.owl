    <!-- http://purl.obolibrary.org/obo/ARO_3003202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003201"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TLA-1 is a beta-lactamase found in plasmids of clinical isolates of Escherichia coli strain R170 in Latin America. It preferentially hydrolyzed cephaloridine, cefotaxime, cephalothin, benzylpenicillin, and ceftazidime. The enzyme was markedly inhibited by sulbactam, tazobactam, and clavulanic acid.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003202</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TLA-1</rdfs:label>
    </owl:Class>
