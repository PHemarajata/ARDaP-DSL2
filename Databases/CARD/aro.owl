    <!-- http://purl.obolibrary.org/obo/ARO_3000642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000032"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cefadroxil, or p-hydroxycephalexin, is an cephalosporin antibiotic similar to cefalexin.</obo:IAO_0000115>
