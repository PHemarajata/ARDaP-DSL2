        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A serotype or serovar is a group of microorganisms, viruses, or cells classified together based on their cell surface antigens.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">serotype</oboInOwl:hasExactSynonym>
