        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Phenoxymethylpenicillin, or penicillin V, is a penicillin derivative that is acid stable but less active than benzylpenicillin (penicillin G).</owl:annotatedTarget>
