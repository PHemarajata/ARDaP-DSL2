    <!-- http://purl.obolibrary.org/obo/ARO_3000870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Triclosan is a common antibacterial agent added to many consumer products as a biocide.  It is an inhibitor of fatty acid biosynthesis by blocking enoyl-carrier protein reductase (FabI).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:5564</oboInOwl:hasDbXref>
