    <!-- http://purl.obolibrary.org/obo/ARO_3000119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000053"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edeines are basic linear peptides produced by Bacillus brevis Vm4. They have antibacterial as well as antifungal, antiviral, and anticancer properties. Edeines are bacteriostatic and bacteriocidal at low and high concentrations, respectively. They are able to inhibit DNA synthesis and protein translation. These compounds are synthesized by nonribosomal peptide synthetases and contain numerous unusual amino acids.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000119</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">edeine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000119"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Edeines are basic linear peptides produced by Bacillus brevis Vm4. They have antibacterial as well as antifungal, antiviral, and anticancer properties. Edeines are bacteriostatic and bacteriocidal at low and high concentrations, respectively. They are able to inhibit DNA synthesis and protein translation. These compounds are synthesized by nonribosomal peptide synthetases and contain numerous unusual amino acids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:70202</oboInOwl:hasDbXref>
    </owl:Axiom>
    


