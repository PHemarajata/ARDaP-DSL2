    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000240"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000241"/>
