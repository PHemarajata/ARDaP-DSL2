    <!-- http://purl.obolibrary.org/obo/ARO_3000037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000037">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Pfam database is a large collection of protein families, each represented by multiple sequence alignments and hidden Markov models (HMMs). A hidden Markov model (HMM) is a statistical model in which the system being modeled is assumed to be a Markov process with unobserved state. A HMM can be considered as the simplest dynamic Bayesian network.  Protein domain HMMs are used to model protein domains for both protein annotation and detection.  HMMs are used by CARD as tools for annotation of proteins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000037</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pfam-HMM</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Pfam database is a large collection of protein families, each represented by multiple sequence alignments and hidden Markov models (HMMs). A hidden Markov model (HMM) is a statistical model in which the system being modeled is assumed to be a Markov process with unobserved state. A HMM can be considered as the simplest dynamic Bayesian network.  Protein domain HMMs are used to model protein domains for both protein annotation and detection.  HMMs are used by CARD as tools for annotation of proteins.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:19920124</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:20180275</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000039">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regular expressions, also referred to as regex or regexp, provide a concise and flexible means for matching strings of text, such as particular characters, words, or patterns of characters.  Annotation regular expression are used by CARD to assign ontology terms to genes, proteins, or other genomic features based on their text descriptions and annotations.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regexp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000039</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RegEx</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0001004"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hydrolysis of an antibiotic molecule to confer resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000040</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hydrolysis of antibiotic conferring resistance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000041">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regular expressions, also referred to as regex or regexp, provide a concise and flexible means for matching strings of text, such as particular characters, words, or patterns of characters. Annotation regular expression are used by CARD to assign ontology terms to genes, proteins, or other genomic features based on their text descriptions and annotations.  Annotation exclusion regular expression (Anti-RegEx) define matches to annotation regular expressions that should not be considered for assignment of an ontology term.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000041</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-RegEx</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000076"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antibiotic adjuvants shown to inhibit the action of a beta-lactamase enzyme or enhance the ability of a beta-lactam antibiotic. These compounds are used along with antibiotics to treat beta-lactam-resistant infectious pathogens.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000042</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">beta-lactamase inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000078"/>
