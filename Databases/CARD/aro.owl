        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cephapirin is a first-generation cephalosporin and broad spectrum beta-lactam antibiotic. Inactivation of penicillin-binding proteins through cephapirin binding disrupts peptidoglycan cross-linking, resulting in cell lysis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:30699</oboInOwl:hasDbXref>
