        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluoroquinolone-resistant Pseudomonas aeruginosa</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004327">
