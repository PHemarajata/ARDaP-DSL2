    <!-- http://purl.obolibrary.org/obo/ARO_3000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000240"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000557"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resistance to streptogramin antibiotics may be conferred through enzymatic inactivation. There are two known mechanisms of streptogramin inactivation shown clinically to confer resistance: 1) vgB lyase enzymes linearize type B streptogramin antibiotics by breaking the ester linkage; 2) vat acetyltransferase enzymes modify type A streptogramin antibiotics by transferring an acetyl group from acetyl-CoA to the secondary streptogramin hydroxyl. Both mechanisms result in antibiotic inactivation thus conferring resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000233</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">streptogramin inactivation enzyme</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000233"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Resistance to streptogramin antibiotics may be conferred through enzymatic inactivation. There are two known mechanisms of streptogramin inactivation shown clinically to confer resistance: 1) vgB lyase enzymes linearize type B streptogramin antibiotics by breaking the ester linkage; 2) vat acetyltransferase enzymes modify type A streptogramin antibiotics by transferring an acetyl group from acetyl-CoA to the secondary streptogramin hydroxyl. Both mechanisms result in antibiotic inactivation thus conferring resistance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:11467949</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12771141</oboInOwl:hasDbXref>
    </owl:Axiom>
    


