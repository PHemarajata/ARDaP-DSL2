    <!-- http://purl.obolibrary.org/obo/ARO_3000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enzyme that catalyzes the inactivation of an antibiotic resulting in resistance.  Inactivation includes chemical modification, destruction, etc.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000557</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic inactivation enzyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000408"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Folate is an essential precursor for many nucleotides and amino acids, making folate biosynthesis a desirable target for antibiotics. Mutation to enzymes within the folate biosynthetic pathway can reverse antibiotic action. Modification of dihydropteroate synthase (folP) can result in resistance to sulfonamide antibiotics. Resistance can be conferred by mutation to the native folP gene or by acquiring a resistant DHPS (sul) gene through gene transfer. The sul gene has three known variants (sul1, sul2, sul3) and encodes a highly resistant dihydropteroate synthase that can be acquired via transposons or plasmids.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modification of folP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modification of sul1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000558</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sulfonamide resistant dihydropteroate synthase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Folate is an essential precursor for many nucleotides and amino acids, making folate biosynthesis a desirable target for antibiotics. Mutation to enzymes within the folate biosynthetic pathway can reverse antibiotic action. Modification of dihydropteroate synthase (folP) can result in resistance to sulfonamide antibiotics. Resistance can be conferred by mutation to the native folP gene or by acquiring a resistant DHPS (sul) gene through gene transfer. The sul gene has three known variants (sul1, sul2, sul3) and encodes a highly resistant dihydropteroate synthase that can be acquired via transposons or plasmids.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:11432417</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000451"/>
