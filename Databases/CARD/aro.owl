        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cefalotin is a semisynthetic cephalosporin antibiotic activate against staphylococci. It is resistant to staphylococci beta-lactamases but hydrolyzed by enterobacterial beta-lactamases.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:6024</oboInOwl:hasDbXref>
