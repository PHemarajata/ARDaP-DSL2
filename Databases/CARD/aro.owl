    <!-- http://purl.obolibrary.org/obo/ARO_3004294 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004293"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromosome-encoded  class C cephalosporinase and penicillinase from Buttiauxella spp. shown clinically to confer resistance to beta-lactam antibiotics. Described by Fihman et al. 2002.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
