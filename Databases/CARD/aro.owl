        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000035"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moemomycin antibiotics are phosphoglycolipids that contain a 3-phosphoglyceric acid, often used as a mixture. They inhibit petidoglycan glycosyltransferases to prevent bacterial cell wall biosynthesis.</obo:IAO_0000115>
