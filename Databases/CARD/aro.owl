        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aminosalicylate resistant thymidylate synthase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004153">
