        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Pseudomonas aeruginosa that has tested resistant (R) to at least one of the following: amikacin, gentamicin, tobramycin</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
