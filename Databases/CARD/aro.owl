    <!-- http://purl.obolibrary.org/obo/ARO_3000867 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oleandomycin is a 14-membered macrolide produced by Streptomyces antibioticus. It is ssimilar to erythromycin, and contains a desosamine amino sugar and an oleandrose sugar. It targets the 50S ribosomal subunit to prevent protein synthesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:19822</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000867</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oleandomycin</rdfs:label>
    </owl:Class>
    


