    <!-- http://purl.obolibrary.org/obo/ARO_3001257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3001310"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Unphenelfamycin was isolated from two environmental isolates called AB999F-80 and AB1047T-33. They were both identified as Streptomyces violaceoniger strains. Both these strains were found to produce phenelfamycins A-F and unphenelfamycin. Unphenelfamycin has a monosaccaride moeity and lacks the  phenacetyl moeity present in the other phenelfamycins. All phenelfamycins were selected due to their activity against anaerobic bacteria, especially Clostridium difficile.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:6443942</oboInOwl:hasDbXref>
