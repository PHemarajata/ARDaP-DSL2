            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Class A beta-lactamases are one of the subgroups of beta-lactamases that are classified as serine enzymes. Class A beta-lactamases exhibit a large degree of variability and are known to hydrolyze penicillins.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
