        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MexAB-OprM is a multidrug efflux protein expressed in the Gram-negative Pseudomonas aeruginosa. MexA is the membrane fusion protein; MexB is the inner membrane transporter; and OprM is the outer membrane channel. MexAB-OprM is associated with resistance to fluoroquinolones, chloramphenicol, erythromycin, azithromycin, novobiocin, and certain β-lactams and lastly over-expression is linked to colistin resistance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000386</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MexAB-OprM</rdfs:label>
    </owl:Class>
