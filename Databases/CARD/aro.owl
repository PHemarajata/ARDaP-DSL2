    <!-- http://purl.obolibrary.org/obo/ARO_3004292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004232"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromosome-encoded class C beta-lactamase described in the pathogen Laribacter hongkongensis, often associated with gastroenteritis. Laribacter ampC has been shown to confer resistance to non-carbapenem beta-lactamases, as described by Lau et al. 2005.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">blaLHK-5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004292</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Laribacter hongkongensis ampC beta-lactamase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004292"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chromosome-encoded class C beta-lactamase described in the pathogen Laribacter hongkongensis, often associated with gastroenteritis. Laribacter ampC has been shown to confer resistance to non-carbapenem beta-lactamases, as described by Lau et al. 2005.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15855519</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004293 -->

