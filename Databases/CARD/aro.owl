    <!-- http://purl.obolibrary.org/obo/ARO_3000505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000505">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An AR peptide is a peptide sequence predicted to be unique to antibiotic resistance proteins under mass spectrometry analysis.  Peptide sequences are predicted from in silico trypsin digestion (cleaves C-terminal side of K or R but not if P is C-terminal to K or R; cysteines treated with nothing).  Fragments found in both resistance and non-resistance proteins are not tagged as AR peptides.  The reference non-resistance protein set is generated from all complete genome and plasmid sequences in CARD. The completeness of this reference in CARD is important for interpretation of AR peptide tagging. Fragments of less than 6 amino acids are not included.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000505</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AR peptide</rdfs:label>
    </owl:Class>
    


