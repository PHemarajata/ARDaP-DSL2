        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gramicidins are a family of antibiotics synthesized by Bacillus brevis. It includes the linear pentadecapeptides gramicidin A, B and C that make up the mixture gramicidin D. Gramicidin S is a cyclic peptide chain. Gramicidins are also components of tyrothricins, another mixture of antibiotics produced by Bacillus brevis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000123</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gramicidin</rdfs:label>
    </owl:Class>
    


