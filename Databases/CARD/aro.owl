        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Directed pumping of antibiotic out of a cell to confer resistance. Multidrug and toxic compound extrusion (MATE) transporters utilize the cationic gradient across the membrane as an energy source. Although there is a diverse substrate specificity, almost all MATE transporters recognize fluoroquinolones. Arciflavine, ethidium and aminoglycosides are also good substrates.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000112</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">multidrug and toxic compound extrusion (MATE) transporter</rdfs:label>
    </owl:Class>
