        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dirithromycin is an oxazine derivative of erythromycin, sharing the 14-carbon macrolide ring. The antibiotic binds to the 50S subunit of the ribosome to inhibit bacterial protein synthesis.</obo:IAO_0000115>
