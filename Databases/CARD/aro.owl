        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MexXY-OprM is a multidrug efflux protein expressed in Pseudomonas aeruginosa. MexY is the membrane fusion protein; MexX is the RND-type membrane protein; and OprM is the outer membrane channel. MexXY-OprM is associated with resistance to acriflavine, erythromycin, norfloxacin and ofloxacin. The efflux system may also be involved in acquisition of higher resistance, in particular when bacteria are repeatedly exposed to subinhibitory doses of AGs.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003032</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MexXY-OprM</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3003032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MexXY-OprM is a multidrug efflux protein expressed in Pseudomonas aeruginosa. MexY is the membrane fusion protein; MexX is the RND-type membrane protein; and OprM is the outer membrane channel. MexXY-OprM is associated with resistance to acriflavine, erythromycin, norfloxacin and ofloxacin. The efflux system may also be involved in acquisition of higher resistance, in particular when bacteria are repeatedly exposed to subinhibitory doses of AGs.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12654672</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:9925549</oboInOwl:hasDbXref>
