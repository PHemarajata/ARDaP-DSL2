    <!-- http://purl.obolibrary.org/obo/ARO_3000872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000871"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_targeted_by"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000870"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enoyl-acyl carrier reductases catalyze the final enoyl reduction step in bacterial type II fatty acid elongation. Triclosan antibiotics block enoyl reduction and therefore fatty acid synthesis, functioning as a broad spectrum biocide and antibiotic.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3000872</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic sensitive enoyl-acyl carrier reductase</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3000872"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enoyl-acyl carrier reductases catalyze the final enoyl reduction step in bacterial type II fatty acid elongation. Triclosan antibiotics block enoyl reduction and therefore fatty acid synthesis, functioning as a broad spectrum biocide and antibiotic.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:14736233</oboInOwl:hasDbXref>
    </owl:Axiom>
    


