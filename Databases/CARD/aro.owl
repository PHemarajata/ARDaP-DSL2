        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EUCAST antimicrobial phenotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004431"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A microbe whose susceptibility to antibiotics is comparable to that of a reference susceptible microbe, meaning that the microbe is sensitive to the particular antibiotic.</obo:IAO_0000115>
