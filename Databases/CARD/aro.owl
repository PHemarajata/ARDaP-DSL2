    <!-- http://purl.obolibrary.org/obo/ARO_3000481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010001"/>
