    <!-- http://purl.obolibrary.org/obo/ARO_3003076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000751"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003073"/>
