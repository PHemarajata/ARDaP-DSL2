    <!-- http://purl.obolibrary.org/obo/ARO_3001298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000315"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004274"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-erm 23S ribosomal RNA methyltransferases modify guanosine 748 (E. coli numbering) to confer resistance to some macrolides and lincosamides</obo:IAO_0000115>
