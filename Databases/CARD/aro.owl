    <!-- http://purl.obolibrary.org/obo/ARO_0000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000020"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ertapenem is a carbapenem antibiotic and is highly resistant to beta-lactamases like other carbapenems. It inhibits bacterial cell wall synthesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:150610</oboInOwl:hasDbXref>
