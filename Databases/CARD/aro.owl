        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Pseudomonas aeruginosa that has tested resistant (R) to at least one of the following: piperacillin, piperacillin/tazobactam</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3004328</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pipericillin-resistant Pseudomonas aeruginosa</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004305"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Enterococcus faecium or Enterococcus faecalis that has tested resistant (R) to vancomycin</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VRE</oboInOwl:hasExactSynonym>
