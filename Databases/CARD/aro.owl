            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_targeted_by_drug"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000497"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EmbA is an arabinosyltransferase that works as a heterodimer with EmbB. It is involved in the synthesis of arabinogalactan, a component of the mycobacterial cell wall.</obo:IAO_0000115>
