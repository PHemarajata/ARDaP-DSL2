    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000000"/>
