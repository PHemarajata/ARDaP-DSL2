        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The P-site of the ribosome binds the peptidyl-tRNA with the growing polypeptide chain. Antibiotics that target the P-site block fMet-tRNA from entering, thus inhibiting peptide elongation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15755955</oboInOwl:hasDbXref>
    </owl:Axiom>
    


