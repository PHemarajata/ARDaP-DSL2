    <!-- http://purl.obolibrary.org/obo/ARO_3004331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004305"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Coagulase-Negative Staphylococci that has tested resistant(R) or intermediate(I) to vancomycin</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
