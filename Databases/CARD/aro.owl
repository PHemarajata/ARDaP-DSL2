        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cell membrane component enzymes targeted by antibiotic</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3003274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3003274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3003273"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cardiolipin synthetase catalyzes the formation of cardiolipin from two phosphatidylglycerol molecules. Cardiolipin is important in membrane translocation and permeabilization. The inactivation of this enzyme by antibiotics leads to cell death.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3003274</oboInOwl:id>
