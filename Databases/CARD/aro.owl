        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VEB beta-lactamases or Vietnamese extended-spectrum beta-lactamases are class A beta-lactamases that confer high-level resistance to oxyimino cephalosporins and to aztreonam</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
