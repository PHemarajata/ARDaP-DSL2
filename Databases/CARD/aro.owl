        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinafloxacin is a fluoroquinolone antibiotic and gyrase (DNA topoisomerase II) inhibitor. It binds to DNA gyrase and disrupts replication by causing double-stranded DNA breaks, resulting in cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:60063</oboInOwl:hasDbXref>
