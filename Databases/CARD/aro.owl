            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enzymes, other proteins or other gene products shown clinically to confer resistance to phenicol (chloramphenicol) antibiotics. These include chloramphenicol acetyltransferase (CAT) enzymes, which are found in a large number of species.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
