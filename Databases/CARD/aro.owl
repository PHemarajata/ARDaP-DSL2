    <!-- http://purl.obolibrary.org/obo/ARO_3000688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3004116"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Furazolidone is a nitrofuran antibiotic that is a non-ionic synthetic compound. It is taken orally and is active against many enteric pathogens. Furazolidone also has antiprotozoal activity and acts by inhibiting monoamine oxidase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:5323714</oboInOwl:hasDbXref>
