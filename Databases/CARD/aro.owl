        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enzymes, other proteins or other gene products shown clinically to confer resistance to the antibiotic drug, isoniazid.</obo:IAO_0000115>
