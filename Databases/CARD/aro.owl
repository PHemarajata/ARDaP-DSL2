        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any Enterococcus faecium or Enterococcus faecalis that has tested non-susceptible (NS) to daptomycin</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
