    <!-- http://purl.obolibrary.org/obo/ARO_3001208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000381"/>
