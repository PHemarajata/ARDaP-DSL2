    <!-- http://purl.obolibrary.org/obo/ARO_3004152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000031"/>
