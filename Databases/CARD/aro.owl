    <!-- http://purl.obolibrary.org/obo/ARO_0000060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000032"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ceftazidime is a third-generation cephalosporin antibiotic. Like other third-generation cephalosporins, it has broad spectrum activity against Gram-positive and Gram-negative bacteria. Unlike most third-generation agents, it is active against Pseudomonas aeruginosa, however it has weaker activity against Gram-positive microorganisms and is not used for such infections.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:5481173</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAZ</oboInOwl:hasExactSynonym>
