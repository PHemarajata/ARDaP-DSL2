                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000032"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO#_confers_resistance_to"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_0000044"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
