    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000007"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cephems have a six-membered dihydrothiazine ring with a sulfur atom and double bond fused with its beta-lactam ring. This group includes the cephalosporins and cephamycins, the latter containing an additional alpha-methoxy group.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
