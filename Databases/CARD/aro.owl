                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ARO_3000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXY beta-lactamases are chromosomal class A beta-lactamases that are found in Klebsiella oxytoca. At constitutive low levels, OXY beta-lactamases confer resistance to aminopenicillins and carboxypenicillins. At high induced levels,  OXY beta-lactamases confer resistance to penicillins, cephalosporins and aztreonam.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">K1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">KOXY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">antibiotic_resistance</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARO:3002388</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OXY beta-lactamase</rdfs:label>
    </owl:Class>
