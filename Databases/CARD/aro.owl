    <!-- http://purl.obolibrary.org/obo/ARO_3001329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3001329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0010002"/>
