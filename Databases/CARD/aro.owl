    <!-- http://purl.obolibrary.org/obo/ARO_3000554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mupirocin, also known as pseudomonic acid, is a bacteriostatic polyketide antibiotic from Pseudomonas fluorescens used to treat S. aureus and MRSA. It inhibits Ile tRNA synthetase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:446596</oboInOwl:hasDbXref>
