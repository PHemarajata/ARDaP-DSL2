    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/ARO_3004011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinafloxacin is a fluoroquinolone antibiotic and gyrase (DNA topoisomerase II) inhibitor. It binds to DNA gyrase and disrupts replication by causing double-stranded DNA breaks, resulting in cell death.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:3142350</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3004012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000001"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clofazimine is a fluoroquinolone-class phenazine dye used for the treatment of leprosy. Clofazimine binds to DNA and disrupts bacterial DNA gyrase, thereby causing double-stranded DNA breaks, and subsequent cell death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PubChem:2794</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lampren</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lamprene</oboInOwl:hasExactSynonym>
