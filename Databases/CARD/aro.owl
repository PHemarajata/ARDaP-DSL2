    <!-- http://purl.obolibrary.org/obo/ARO_3004283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3004283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000129"/>
