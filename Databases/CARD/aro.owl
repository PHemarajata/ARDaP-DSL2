    <!-- http://purl.obolibrary.org/obo/ARO_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_0000016"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sisomicin is an aminoglycoside antibiotic used to treat different types of bacterial infections. Sisomicin works by binding to the bacterial 30S ribosomal subunit, causing misreading of mRNA and leaving the bacterium unable to synthesize proteins vital to its growth.</obo:IAO_0000115>
