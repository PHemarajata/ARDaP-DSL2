    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ARO_3000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ARO_3000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ARO_3000052"/>
