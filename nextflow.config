/*
 * ARDaP DSL2 Configuration
 * Version 2.4.0
 */

params {
    // Input parameters
    fastq               = "*_{1,2}.fastq.gz"
    assemblies          = false
    assembly_loc        = "assemblies/*.fasta"
    species             = "Burkholderia_pseudomallei"
    patientMetaData     = "${baseDir}/Reports/data/patientMetaData.csv"
    
    // Analysis parameters
    gwas                = false
    notrim              = true
    matrix              = false
    annotate            = true
    mixtures            = false
    phylogeny           = false
    antibiotic_res      = true
    strain              = "all"
    tech                = "Illumina"
    pairing             = "PE"
    window              = 10000
    indel_merge         = true
    tri_tetra_allelic   = false
    size                = 1000000
    phred               = "-phred33"
    org                 = "haploid"
    delly               = true
    fast                = true
    
    // Execution parameters
    executor            = "local"
    publish_clean_reads = false
    
    // Reference parameters
    insert_size         = 500
    reference_name      = "ref"
    reference_date      = "2023-01-01"
    
    // Output parameters
    outdir              = "./Outputs"
    tracedir            = "${params.outdir}/pipeline_info"
    
    // Resource limits
    max_memory          = '128.GB'
    max_cpus            = 128
    max_time            = '240.h'
}

// Include GATK configuration
includeConfig 'configs/gatk.config'

// Enable conda and set up environment management
conda {
    enabled = false
    useMamba = false
    createTimeout = '1 h'
    cacheDir = "$HOME/.conda/envs"
}

// Enable Singularity/Apptainer support
singularity {
    enabled = false
    autoMounts = true
    cacheDir = "$HOME/.singularity"
}

// Enable Docker support
docker {
    enabled = false
    userEmulation = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Global process configuration
process {
    // Conda environment for all processes
    conda = "${baseDir}/environment.yml"
    
    // Global error strategy
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries = 3
    maxErrors = '-1'
    
    // Resource requirements by process label
    withLabel: art {
        cpus = { check_max( 1 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 8.h * task.attempt, 'time' ) }
    }
    
    withLabel: card {
        cpus = { check_max( 1, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 8.h * task.attempt, 'time' ) }
    }
    
    withLabel: index {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 4.h * task.attempt, 'time' ) }
    }
    
    withLabel: ardap_default {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 24.h * task.attempt, 'time' ) }
    }
    
    withLabel: alignment {
        cpus = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 24.h * task.attempt, 'time' ) }
    }
    
    withLabel: trimmomatic {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 12.h * task.attempt, 'time' ) }
    }
    
    withLabel: markduplicates {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 24.h * task.attempt, 'time' ) }
    }
    
    withLabel: gatk_haplo {
        cpus = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time = { check_max( 48.h * task.attempt, 'time' ) }
    }
    
    withLabel: gatk {
        cpus = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time = { check_max( 24.h * task.attempt, 'time' ) }
    }
    
    withLabel: snpeff {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 12.h * task.attempt, 'time' ) }
    }
    
    withLabel: pindel {
        cpus = { check_max( 4 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 96.h * task.attempt, 'time' ) }
    }
    
    withLabel: genomic_queries {
        cpus = { check_max( 1, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 8.h * task.attempt, 'time' ) }
    }
    
    withLabel: card_queries {
        cpus = { check_max( 1, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
        time = { check_max( 2.h * task.attempt, 'time' ) }
    }
    
    withLabel: report {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 4.h * task.attempt, 'time' ) }
    }
    
    withLabel: master_vcf {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time = { check_max( 12.h * task.attempt, 'time' ) }
    }
    
    withLabel: snp_matrix {
        cpus = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time = { check_max( 24.h * task.attempt, 'time' ) }
    }
}

// Execution profiles
profiles {
    
    // Standard local execution
    standard {
        process.executor = 'local'
    }
    
    // Local workstation with 22 cores and 64GB RAM
    workstation {
        params.max_memory = '56.GB'  // Reserve 8GB for system
        params.max_cpus = 20         // Reserve 2 cores for system
        params.max_time = '72.h'
        
        process {
            executor = 'local'
            
            // Optimized resource allocation for workstation
            withLabel: alignment {
                cpus = { check_max( 8 * task.attempt, 'cpus' ) }
                memory = { check_max( 16.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: gatk_haplo {
                cpus = { check_max( 6 * task.attempt, 'cpus' ) }
                memory = { check_max( 24.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: gatk {
                cpus = { check_max( 6 * task.attempt, 'cpus' ) }
                memory = { check_max( 20.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: pindel {
                cpus = { check_max( 8 * task.attempt, 'cpus' ) }
                memory = { check_max( 16.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: snp_matrix {
                cpus = { check_max( 4 * task.attempt, 'cpus' ) }
                memory = { check_max( 32.GB * task.attempt, 'memory' ) }
            }
        }
        
        executor {
            name = 'local'
            cpus = 20
            memory = '56 GB'
            queueSize = 4  // Limit concurrent jobs
        }
    }
    
    // NVIDIA DGX Station A100 with 128 cores and 512GB RAM  
    dgx {
        params.max_memory = '480.GB'  // Reserve 32GB for system
        params.max_cpus = 120         // Reserve 8 cores for system
        params.max_time = '168.h'     // 1 week max
        
        process {
            executor = 'local'
            
            // High-performance resource allocation for DGX
            withLabel: alignment {
                cpus = { check_max( 16 * task.attempt, 'cpus' ) }
                memory = { check_max( 32.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: gatk_haplo {
                cpus = { check_max( 12 * task.attempt, 'cpus' ) }
                memory = { check_max( 64.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: gatk {
                cpus = { check_max( 12 * task.attempt, 'cpus' ) }
                memory = { check_max( 48.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: pindel {
                cpus = { check_max( 16 * task.attempt, 'cpus' ) }
                memory = { check_max( 32.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: snp_matrix {
                cpus = { check_max( 8 * task.attempt, 'cpus' ) }
                memory = { check_max( 128.GB * task.attempt, 'memory' ) }
            }
            
            withLabel: markduplicates {
                cpus = { check_max( 4 * task.attempt, 'cpus' ) }
                memory = { check_max( 32.GB * task.attempt, 'memory' ) }
            }
        }
        
        executor {
            name = 'local'
            cpus = 120
            memory = '480 GB'
            queueSize = 8  // Allow more concurrent jobs on high-core system
        }
    }
    
    // Test profile for quick runs
    test {
        params.size = 10000  // Very small subset
        params.max_memory = '6.GB'
        params.max_cpus = 2
        params.max_time = '1.h'
        
        process {
            withLabel: '.*' {
                cpus = 1
                memory = '2.GB'
                time = '30.m'
            }
        }
    }
    
    // Conda profile
    conda {
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = false
        singularity.enabled = false
        process.conda = "${baseDir}/environment.yml"
    }
    
    // Singularity profile
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
    }
    
    // Docker profile  
    docker {
        docker.enabled = true
        docker.userEmulation = true
        conda.enabled = false
        singularity.enabled = false
    }
}

// Function to check resource limits
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: ${obj}"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: ${obj}"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: ${obj}"
            return obj
        }
    }
}

// Pipeline metadata
manifest {
    name = 'PHemarajata/ARDaP-DSL2'
    author = 'Derek Sarovich, Erin Price, Danielle Madden, Eike Steinig'
    homePage = 'https://github.com/PHemarajata/ARDaP-DSL2'
    description = 'Comprehensive antimicrobial resistance detection from whole genome sequencing data DSL2 implementation'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '2.4.0'
    doi = ''
}

// Execution reporting
timeline {
    enabled = true
    file = "${params.tracedir}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.tracedir}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.tracedir}/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.tracedir}/pipeline_dag.html"
    overwrite = true
}

// Cleanup settings moved to resume section above

// Resume settings - critical for proper resumability  
resume = true
workDir = './work'

// Ensure work directory permissions and proper cleanup
process.scratch = false
cleanup = false